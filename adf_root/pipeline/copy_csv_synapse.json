{
	"name": "copy_csv_synapse",
	"properties": {
		"activities": [
			{
				"name": "Copy data_to_synapse",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "SqlDWSink",
						"allowCopyCommand": true,
						"tableOption": "autoCreate",
						"disableMetricsCollection": false
					},
					"enableStaging": true,
					"stagingSettings": {
						"linkedServiceName": {
							"referenceName": "adls1",
							"type": "LinkedServiceReference"
						},
						"path": "raw"
					}
				},
				"inputs": [
					{
						"referenceName": "ds_csv",
						"type": "DatasetReference",
						"parameters": {
							"filename": {
								"value": "@pipeline().parameters.src_filename",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_synapse",
						"type": "DatasetReference",
						"parameters": {
							"tablename": {
								"value": "@pipeline().parameters.tgt_table",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"src_filename": {
				"type": "string"
			},
			"tgt_table": {
				"type": "string"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-02-20T20:09:31Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}